rules_version = '2';
// Solo las cuentas de Google de esta lista pueden ver y editar los datos.
// Agrega o quita correos y vuelve a "Publicar" las reglas en Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'correo1@empresa.pe',
          'correo2@empresa.pe'
        ];
    }
    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
