rules_version = '2';
// Solo las cuentas de Google de esta lista pueden ver y editar los datos.
// Para dar acceso a otra persona: agrega su correo en minusculas, y copia estas reglas en
// Firebase Console > Firestore Database > Reglas > Publicar (proyecto incidencias-sky).
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'coord.ope.directo@gmail.com',
          'osoriopiomel@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if autorizado();
    }
  }
}
